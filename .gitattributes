# Machine-contract JSON files are checked in as deterministic byte sequences and
# must compare byte-for-byte against `serde_json::to_string_pretty` output across
# all supported CI platforms. Forcing LF here overrides any host `core.autocrlf`
# or runner default that would otherwise convert these canonical fixtures and
# active schemas to CRLF on Windows checkouts, breaking the exact contract
# comparisons in `crates/eggprobe-core/tests/contract.rs` without weakening the
# assertions themselves. Historical schemas (`*-0.1.json`, `*-0.2.json`) are
# immutable evidence and follow the same rule.

crates/eggprobe-core/tests/fixtures/*.json text eol=lf
schemas/*.json text eol=lf
