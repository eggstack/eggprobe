{
  "$defs": {
    "AddressFamily": {
      "description": "IP address family.",
      "oneOf": [
        {
          "const": "ipv4",
          "description": "IPv4.",
          "type": "string"
        },
        {
          "const": "ipv6",
          "description": "IPv6.",
          "type": "string"
        }
      ]
    },
    "DiagnosticError": {
      "additionalProperties": false,
      "description": "A bounded, redaction-safe diagnostic error.",
      "properties": {
        "attempt": {
          "description": "Optional retry/attempt context.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/DiagnosticErrorKind",
          "description": "Stable category."
        },
        "message": {
          "description": "Bounded message with credentials removed by the producer.",
          "type": "string"
        },
        "route_hop_index": {
          "description": "Zero-based Eggress route hop that reported the failure, when available.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "route_protocol": {
          "description": "Normalized Eggress hop protocol associated with the failure, when available.",
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "$ref": "#/$defs/DiagnosticStage",
          "description": "Observable failure stage."
        }
      },
      "required": [
        "kind",
        "stage",
        "message"
      ],
      "type": "object"
    },
    "DiagnosticErrorKind": {
      "description": "Protocol-neutral diagnostic failure category.",
      "oneOf": [
        {
          "const": "dns",
          "description": "Name resolution failed.",
          "type": "string"
        },
        {
          "const": "timeout",
          "description": "A configured deadline or timeout was exceeded.",
          "type": "string"
        },
        {
          "const": "connection_refused",
          "description": "The target actively refused a connection.",
          "type": "string"
        },
        {
          "const": "network_unreachable",
          "description": "No route to the network was available.",
          "type": "string"
        },
        {
          "const": "host_unreachable",
          "description": "The target host was unreachable.",
          "type": "string"
        },
        {
          "const": "authentication",
          "description": "Authentication or authorization failed.",
          "type": "string"
        },
        {
          "const": "permission_denied",
          "description": "Local operating-system permission denied the operation.",
          "type": "string"
        },
        {
          "const": "tls",
          "description": "TLS negotiation or verification failed.",
          "type": "string"
        },
        {
          "const": "protocol",
          "description": "Protocol exchange failed.",
          "type": "string"
        },
        {
          "const": "policy",
          "description": "Local policy rejected the operation.",
          "type": "string"
        },
        {
          "const": "io",
          "description": "Local I/O failed.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "The requested operation is not supported.",
          "type": "string"
        },
        {
          "const": "internal",
          "description": "Eggprobe could not classify the failure safely.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A dependency-specific error did not fit the stable categories.",
          "type": "string"
        }
      ]
    },
    "DiagnosticStage": {
      "description": "The stage where a diagnostic error occurred.",
      "oneOf": [
        {
          "const": "resolution",
          "description": "Name resolution.",
          "type": "string"
        },
        {
          "const": "direct_connect",
          "description": "Direct connection establishment.",
          "type": "string"
        },
        {
          "const": "hop_connect",
          "description": "Proxy hop connection.",
          "type": "string"
        },
        {
          "const": "hop_handshake",
          "description": "Proxy hop handshake.",
          "type": "string"
        },
        {
          "const": "tls_handshake",
          "description": "TLS handshake.",
          "type": "string"
        },
        {
          "const": "request",
          "description": "HTTP request write.",
          "type": "string"
        },
        {
          "const": "response_headers",
          "description": "HTTP response headers.",
          "type": "string"
        },
        {
          "const": "body",
          "description": "Response body.",
          "type": "string"
        },
        {
          "const": "deadline",
          "description": "Outer deadline handling.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A stage not yet represented by the contract.",
          "type": "string"
        },
        {
          "const": "route_inspection",
          "description": "Local interface and route inspection.",
          "type": "string"
        },
        {
          "const": "packet_exchange",
          "description": "Native packet send or reply observation.",
          "type": "string"
        },
        {
          "const": "hop_probe",
          "description": "Individual traceroute hop probing.",
          "type": "string"
        },
        {
          "const": "path_mtu_discovery",
          "description": "Active path-MTU discovery.",
          "type": "string"
        }
      ]
    },
    "DnsEvidence": {
      "additionalProperties": false,
      "description": "DNS evidence available to a report.",
      "properties": {
        "addresses": {
          "description": "Answers observed by Eggprobe's local system resolver. This does not\nrepresent the resolver used by a remote Eggress proxy route.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resolution_scope": {
          "$ref": "#/$defs/DnsResolutionScope",
          "description": "Resolver scope for these answers."
        }
      },
      "required": [
        "addresses",
        "resolution_scope"
      ],
      "type": "object"
    },
    "DnsResolutionScope": {
      "description": "Resolver that produced the reported DNS answers.",
      "oneOf": [
        {
          "const": "client",
          "description": "Eggprobe's local client/system resolver.",
          "type": "string"
        }
      ]
    },
    "DurationMicros": {
      "description": "A duration represented as integer microseconds in JSON.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "A normalized assertion result, not a replacement for probe status/errors.",
      "properties": {
        "assertion_id": {
          "description": "Stable assertion identifier.",
          "type": "string"
        },
        "message": {
          "description": "Bounded explanation.",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/FindingOutcome",
          "description": "Evaluation outcome."
        },
        "severity": {
          "$ref": "#/$defs/FindingSeverity",
          "description": "Severity assigned by the assertion."
        }
      },
      "required": [
        "assertion_id",
        "severity",
        "outcome",
        "message"
      ],
      "type": "object"
    },
    "FindingOutcome": {
      "description": "Outcome of an assertion evaluation.",
      "oneOf": [
        {
          "const": "passed",
          "description": "The assertion passed.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "The assertion failed.",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "The assertion could not be evaluated from available evidence.",
          "type": "string"
        }
      ]
    },
    "FindingSeverity": {
      "description": "Severity of an evaluated assertion finding.",
      "oneOf": [
        {
          "const": "info",
          "description": "Informational observation.",
          "type": "string"
        },
        {
          "const": "warning",
          "description": "An expectation did not hold.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "A required expectation did not hold.",
          "type": "string"
        }
      ]
    },
    "HttpEvidence": {
      "additionalProperties": false,
      "description": "HTTP evidence available to a report.",
      "properties": {
        "body_sample_bytes": {
          "description": "Number of body bytes retained in the bounded sample.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "protocol": {
          "description": "Negotiated HTTP protocol.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Observed response status.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "IcmpAttempt": {
      "additionalProperties": false,
      "description": "One ICMP attempt.",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/NativeAttemptOutcome",
          "description": "Outcome category."
        },
        "responder": {
          "description": "Responder address, when observed.",
          "type": [
            "string",
            "null"
          ]
        },
        "rtt_micros": {
          "description": "Round-trip microseconds, when observed.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sequence": {
          "description": "One-based sequence.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "outcome"
      ],
      "type": "object"
    },
    "IcmpEchoEvidence": {
      "additionalProperties": false,
      "description": "Bounded ICMP evidence.",
      "properties": {
        "attempts": {
          "description": "Attempts in send order.",
          "items": {
            "$ref": "#/$defs/IcmpAttempt"
          },
          "type": "array"
        },
        "destination": {
          "description": "Destination address.",
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/AddressFamily",
          "description": "Address family."
        },
        "payload_bytes": {
          "description": "Configured payload size.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "destination",
        "family",
        "payload_bytes",
        "attempts"
      ],
      "type": "object"
    },
    "InterfaceEvidence": {
      "additionalProperties": false,
      "description": "Correlated local interface facts.",
      "properties": {
        "addresses": {
          "description": "Interface addresses observed in the platform snapshot.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "index": {
          "description": "Operating-system index.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "mtu": {
          "description": "Interface MTU, distinct from path MTU.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "Interface name.",
          "type": [
            "string",
            "null"
          ]
        },
        "up": {
          "description": "Whether the interface is administratively up, when exposed.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "NativeAttemptOutcome": {
      "description": "Normalized outcome for a native packet attempt.",
      "oneOf": [
        {
          "const": "reply",
          "description": "Echo or service response observed.",
          "type": "string"
        },
        {
          "const": "timed_out",
          "description": "Attempt timed out without a response.",
          "type": "string"
        },
        {
          "const": "destination_unreachable",
          "description": "Destination reported unreachable.",
          "type": "string"
        },
        {
          "const": "network_unreachable",
          "description": "Network reported unreachable.",
          "type": "string"
        },
        {
          "const": "host_unreachable",
          "description": "Host reported unreachable.",
          "type": "string"
        },
        {
          "const": "time_exceeded",
          "description": "Intermediate router reported TTL/hop limit expiration.",
          "type": "string"
        },
        {
          "const": "destination_reached",
          "description": "Destination reached during a trace.",
          "type": "string"
        }
      ]
    },
    "PathMtuEvidence": {
      "additionalProperties": false,
      "description": "PMTU evidence, distinct from interface MTU.",
      "properties": {
        "destination": {
          "description": "Destination.",
          "type": "string"
        },
        "exact_bytes": {
          "description": "Exact path MTU, if established.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "lower_bytes": {
          "description": "Proven lower bound.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "method": {
          "$ref": "#/$defs/PathMtuMethod",
          "description": "Method provenance."
        },
        "status": {
          "$ref": "#/$defs/PathMtuStatus",
          "description": "Result class."
        },
        "upper_bytes": {
          "description": "Explicitly signalled upper bound.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "destination",
        "method",
        "status"
      ],
      "type": "object"
    },
    "PathMtuMethod": {
      "description": "Active packet method used for PMTU discovery.",
      "oneOf": [
        {
          "const": "icmp_echo",
          "description": "ICMP echo request with fragmentation control.",
          "type": "string"
        },
        {
          "const": "udp",
          "description": "Direct UDP probe with fragmentation control.",
          "type": "string"
        }
      ]
    },
    "PathMtuStatus": {
      "description": "PMTU discovery result class.",
      "oneOf": [
        {
          "const": "exact",
          "description": "Exact value established.",
          "type": "string"
        },
        {
          "const": "bounded",
          "description": "Only lower/upper bounds established.",
          "type": "string"
        },
        {
          "const": "inconclusive",
          "description": "No trustworthy size signal.",
          "type": "string"
        }
      ]
    },
    "PhaseTiming": {
      "additionalProperties": false,
      "description": "A named phase duration.",
      "properties": {
        "duration": {
          "$ref": "#/$defs/DurationMicros",
          "description": "Measured phase duration."
        },
        "stage": {
          "$ref": "#/$defs/DiagnosticStage",
          "description": "Boundary at which the duration was measured."
        }
      },
      "required": [
        "stage",
        "duration"
      ],
      "type": "object"
    },
    "ProbeEvidence": {
      "description": "Typed observations produced by each probe family.",
      "oneOf": [
        {
          "description": "DNS observations.",
          "properties": {
            "data": {
              "$ref": "#/$defs/DnsEvidence"
            },
            "kind": {
              "const": "dns",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        },
        {
          "description": "TCP observations.",
          "properties": {
            "data": {
              "$ref": "#/$defs/TcpEvidence"
            },
            "kind": {
              "const": "tcp",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        },
        {
          "description": "TLS observations.",
          "properties": {
            "data": {
              "$ref": "#/$defs/TlsEvidence"
            },
            "kind": {
              "const": "tls",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        },
        {
          "description": "HTTP observations.",
          "properties": {
            "data": {
              "$ref": "#/$defs/HttpEvidence"
            },
            "kind": {
              "const": "http",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        },
        {
          "description": "Route and interface observations.",
          "properties": {
            "data": {
              "$ref": "#/$defs/RouteEvidence"
            },
            "kind": {
              "const": "route",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        },
        {
          "description": "ICMP echo attempt outcomes.",
          "properties": {
            "data": {
              "$ref": "#/$defs/IcmpEchoEvidence"
            },
            "kind": {
              "const": "icmp_echo",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        },
        {
          "description": "UDP transmission and response outcome.",
          "properties": {
            "data": {
              "$ref": "#/$defs/UdpEvidence"
            },
            "kind": {
              "const": "udp",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        },
        {
          "description": "Ordered traceroute hops and termination.",
          "properties": {
            "data": {
              "$ref": "#/$defs/TraceEvidence"
            },
            "kind": {
              "const": "trace",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        },
        {
          "description": "Active path-MTU bounds and provenance.",
          "properties": {
            "data": {
              "$ref": "#/$defs/PathMtuEvidence"
            },
            "kind": {
              "const": "path_mtu",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        }
      ]
    },
    "ProbeKind": {
      "description": "The stable family of a probe result.",
      "oneOf": [
        {
          "const": "dns",
          "description": "DNS lookup.",
          "type": "string"
        },
        {
          "const": "tcp",
          "description": "TCP connection.",
          "type": "string"
        },
        {
          "const": "tls",
          "description": "Standalone TLS handshake.",
          "type": "string"
        },
        {
          "const": "http",
          "description": "HTTP request.",
          "type": "string"
        },
        {
          "const": "route",
          "description": "Target-scoped local route/interface inspection.",
          "type": "string"
        },
        {
          "const": "icmp_echo",
          "description": "ICMP echo.",
          "type": "string"
        },
        {
          "const": "udp",
          "description": "Direct UDP exchange.",
          "type": "string"
        },
        {
          "const": "trace",
          "description": "Traceroute.",
          "type": "string"
        },
        {
          "const": "path_mtu",
          "description": "Active path MTU discovery.",
          "type": "string"
        }
      ]
    },
    "ProbeResult": {
      "additionalProperties": false,
      "description": "One ordered probe result in a report.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosticError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Structured failure, if the probe failed."
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProbeEvidence"
            },
            {
              "type": "null"
            }
          ],
          "description": "Typed observations, if any were produced."
        },
        "findings": {
          "description": "Findings associated with this result.",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ProbeKind",
          "description": "Probe family."
        },
        "status": {
          "$ref": "#/$defs/ProbeStatus",
          "description": "Operation result state."
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timing"
            },
            {
              "type": "null"
            }
          ],
          "description": "Measured timing, if the operation started."
        },
        "unavailable": {
          "description": "Facts that were relevant but unavailable through this observer seam.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "status"
      ],
      "type": "object"
    },
    "ProbeStatus": {
      "description": "Result state of the probe operation itself.",
      "oneOf": [
        {
          "const": "ok",
          "description": "The requested operation completed.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "The operation ran but failed.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "The requested operation is not supported.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "The caller cancelled the operation.",
          "type": "string"
        }
      ]
    },
    "ReportStatus": {
      "description": "Overall execution state; child probe states remain independently visible.",
      "oneOf": [
        {
          "const": "ok",
          "description": "All requested operations completed without a negative probe result.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "At least one probe failed.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "At least one requested operation was unsupported.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "The execution was cancelled.",
          "type": "string"
        }
      ]
    },
    "RouteCandidate": {
      "additionalProperties": false,
      "description": "Read-only route-table candidate.",
      "properties": {
        "destination": {
          "description": "Network prefix.",
          "type": "string"
        },
        "gateway": {
          "description": "Gateway when observed.",
          "type": [
            "string",
            "null"
          ]
        },
        "interface_index": {
          "description": "Interface index when observed.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "metric": {
          "description": "Metric when observed.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "protocol": {
          "description": "Route protocol when exposed by the platform.",
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "description": "Route scope when exposed by the platform.",
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "description": "Table identifier when observed.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "destination"
      ],
      "type": "object"
    },
    "RouteCorrelation": {
      "description": "How route and interface evidence was related.",
      "oneOf": [
        {
          "const": "observed_source",
          "description": "Kernel source address observed and mapped to an interface.",
          "type": "string"
        },
        {
          "const": "correlated_candidates",
          "description": "Candidate route entries matched by prefix only.",
          "type": "string"
        },
        {
          "const": "ambiguous",
          "description": "More than one candidate remains.",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "Backend could not provide correlation.",
          "type": "string"
        }
      ]
    },
    "RouteEvidence": {
      "additionalProperties": false,
      "description": "Target-scoped route/interface evidence. Correlations are explicitly separate.",
      "properties": {
        "correlation": {
          "$ref": "#/$defs/RouteCorrelation",
          "description": "Provenance of any association."
        },
        "interface": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterfaceEvidence"
            },
            {
              "type": "null"
            }
          ],
          "description": "Interface index, name, and MTU correlated with the source."
        },
        "routes": {
          "description": "Candidate route-table entries; never implies authoritative selection.",
          "items": {
            "$ref": "#/$defs/RouteCandidate"
          },
          "type": "array"
        },
        "routes_truncated": {
          "description": "Whether additional equally specific candidates were omitted by the cap.",
          "type": "boolean"
        },
        "source": {
          "description": "Kernel-selected local source address, when observed.",
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "description": "Address inspected.",
          "type": "string"
        }
      },
      "required": [
        "target",
        "correlation"
      ],
      "type": "object"
    },
    "RouteSummary": {
      "description": "A redacted route summary. It cannot hold raw plan credentials.",
      "oneOf": [
        {
          "description": "Direct access.",
          "properties": {
            "kind": {
              "const": "direct",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "An Eggress route was selected; raw route syntax is never report data.",
          "properties": {
            "kind": {
              "const": "eggress",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "TargetSummary": {
      "additionalProperties": false,
      "description": "A report-safe normalized target.",
      "properties": {
        "host": {
          "description": "Normalized host.",
          "type": "string"
        },
        "port": {
          "description": "Selected service port, when relevant.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "host"
      ],
      "type": "object"
    },
    "TcpEvidence": {
      "additionalProperties": false,
      "description": "TCP evidence available to a report.",
      "properties": {
        "attempts": {
          "description": "Number of address attempts made before success.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "local": {
          "description": "Local address when the provider exposes it.",
          "type": [
            "string",
            "null"
          ]
        },
        "peer": {
          "description": "Selected peer address, when observable.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "description": "Timing for one probe, including only phases that were truthfully observed.",
      "properties": {
        "phases": {
          "description": "Ordered phase measurements.",
          "items": {
            "$ref": "#/$defs/PhaseTiming"
          },
          "type": "array"
        },
        "total": {
          "$ref": "#/$defs/DurationMicros",
          "description": "Total measured duration."
        }
      },
      "required": [
        "total"
      ],
      "type": "object"
    },
    "TlsEvidence": {
      "additionalProperties": false,
      "description": "TLS evidence available to a report.",
      "properties": {
        "alpn": {
          "description": "Negotiated application protocol.",
          "type": [
            "string",
            "null"
          ]
        },
        "cipher_suite": {
          "description": "Negotiated cipher suite when observed.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Negotiated TLS protocol version.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ToolProvenance": {
      "additionalProperties": false,
      "description": "Provenance identifying the producer of a report.",
      "properties": {
        "name": {
          "description": "Product name.",
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/ToolVersion",
          "description": "Product/library version, distinct from the schema version."
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "ToolVersion": {
      "description": "The Eggprobe binary/library version that produced a report.",
      "type": "string"
    },
    "TraceAttempt": {
      "additionalProperties": false,
      "description": "One trace attempt.",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/NativeAttemptOutcome",
          "description": "Stable outcome."
        },
        "responder": {
          "description": "Responder address.",
          "type": [
            "string",
            "null"
          ]
        },
        "rtt_micros": {
          "description": "Round-trip microseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "outcome"
      ],
      "type": "object"
    },
    "TraceEvidence": {
      "additionalProperties": false,
      "description": "Trace evidence.",
      "properties": {
        "destination": {
          "description": "Destination.",
          "type": "string"
        },
        "hops": {
          "description": "Ordered hops.",
          "items": {
            "$ref": "#/$defs/TraceHop"
          },
          "type": "array"
        },
        "termination": {
          "$ref": "#/$defs/TraceTermination",
          "description": "Termination."
        }
      },
      "required": [
        "destination",
        "hops",
        "termination"
      ],
      "type": "object"
    },
    "TraceHop": {
      "additionalProperties": false,
      "description": "Ordered trace hop.",
      "properties": {
        "attempts": {
          "description": "Attempts in send order.",
          "items": {
            "$ref": "#/$defs/TraceAttempt"
          },
          "type": "array"
        },
        "hop": {
          "description": "TTL/hop index.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "hop",
        "attempts"
      ],
      "type": "object"
    },
    "TraceTermination": {
      "description": "Path completion reason.",
      "oneOf": [
        {
          "const": "destination_reached",
          "description": "Destination reached.",
          "type": "string"
        },
        {
          "const": "max_hops",
          "description": "Hop bound exhausted.",
          "type": "string"
        },
        {
          "const": "deadline",
          "description": "Global deadline elapsed.",
          "type": "string"
        },
        {
          "const": "unreachable",
          "description": "Destination reported unreachable.",
          "type": "string"
        },
        {
          "const": "permission_denied",
          "description": "Required OS privilege was unavailable.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "Backend unsupported.",
          "type": "string"
        }
      ]
    },
    "UdpEvidence": {
      "additionalProperties": false,
      "description": "Direct UDP evidence.",
      "properties": {
        "local": {
          "description": "Local socket address.",
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/UdpOutcome",
          "description": "Outcome independent of service health."
        },
        "response_bytes": {
          "description": "Response bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "response_sample": {
          "description": "Explicitly requested bounded response sample.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "response_source": {
          "description": "Response source when observed.",
          "type": [
            "string",
            "null"
          ]
        },
        "transmitted_bytes": {
          "description": "Request bytes sent.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "transmitted_bytes",
        "outcome"
      ],
      "type": "object"
    },
    "UdpOutcome": {
      "description": "UDP receive result.",
      "oneOf": [
        {
          "const": "sent",
          "description": "Datagram accepted by local socket.",
          "type": "string"
        },
        {
          "const": "response",
          "description": "Response received.",
          "type": "string"
        },
        {
          "const": "unreachable",
          "description": "OS reported unreachable.",
          "type": "string"
        },
        {
          "const": "timeout",
          "description": "No response before timeout.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The canonical machine-readable result of one plan execution.",
  "properties": {
    "execution_id": {
      "description": "Caller- or engine-provided execution identifier.",
      "type": "string"
    },
    "findings": {
      "description": "Top-level assertion findings.",
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "type": "array"
    },
    "probes": {
      "description": "Ordered child probe results.",
      "items": {
        "$ref": "#/$defs/ProbeResult"
      },
      "type": "array"
    },
    "route": {
      "$ref": "#/$defs/RouteSummary",
      "description": "Safe route summary, intentionally distinct from `RouteSpec`."
    },
    "schema_version": {
      "const": "0.4"
    },
    "status": {
      "$ref": "#/$defs/ReportStatus",
      "description": "Overall execution state."
    },
    "target": {
      "$ref": "#/$defs/TargetSummary",
      "description": "Safe target summary."
    },
    "tool": {
      "$ref": "#/$defs/ToolProvenance",
      "description": "Producer provenance."
    },
    "warnings": {
      "description": "Non-fatal report-level warnings.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "tool",
    "execution_id",
    "target",
    "route",
    "status",
    "probes"
  ],
  "title": "ProbeReport",
  "type": "object"
}
